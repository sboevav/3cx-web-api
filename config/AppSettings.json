{
  "Urls": "http://127.0.0.1:8888",  

  "AppSettings": {
    "DebugMode": "true",
    "SsoUrl": "https://sso.kco1.eu",
    "EndpointSearchContact": "api/public/pbx/3cx/v20/contact/search",
    "EndpointReportCall": "api/public/pbx/3cx/v20/call/create",
    "OnlyUsersContacts": "true",
    "Companies": [
      {
        "Id": 956120,
        "Url": "https://app1.org1.eu"
      }
    ]
   },

  "Serilog": {
    "Using": ["Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log.txt", "rollingInterval": "Day" } }
    ]
  }

}